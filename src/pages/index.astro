</style>

<script>
(function () {
  const canvas = document.getElementById('bg-canvas');
  const ctx = canvas.getContext('2d');

  let W = window.innerWidth;
  let H = window.innerHeight;
  let mouse = { x: W / 2, y: H / 2 };
  let raf;

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
  window.addEventListener('touchmove', e => {
    mouse.x = e.touches[0].clientX;
    mouse.y = e.touches[0].clientY;
  }, { passive: true });

  const CELL = 60;
  const PARTICLE_COUNT = 90;
  const particles = [];

  class Particle {
    constructor() { this.reset(true); }
    reset(random) {
      this.x = random ? Math.random() * W : Math.random() * W;
      this.y = random ? Math.random() * H : H + 10;
      this.vx = (Math.random() - 0.5) * 0.3;
      this.vy = -(Math.random() * 0.4 + 0.1);
      this.radius = Math.random() * 1.5 + 0.4;
      this.alpha = Math.random() * 0.6 + 0.15;
      this.life = 1;
      this.decay = Math.random() * 0.002 + 0.0005;
      const t = Math.random();
      this.r = Math.round(123 + (255 - 123) * t);
      this.g = Math.round(94  + (255 - 94)  * t);
      this.b = Math.round(167 + (255 - 167) * t);
    }
    update() {
      const dx = mouse.x - this.x;
      const dy = mouse.y - this.y;
      const dist = Math.sqrt(dx * dx + dy * dy) || 1;
      if (dist < 200) {
        this.vx += (dx / dist) * 0.012;
        this.vy += (dy / dist) * 0.012;
      }
      this.vx *= 0.98;
      this.vy *= 0.98;
      this.x += this.vx;
      this.y += this.vy;
      this.life -= this.decay;
      if (this.life <= 0 || this.y < -10) this.reset(false);
    }
    draw() {
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${this.r},${this.g},${this.b},${this.alpha * this.life})`;
      ctx.fill();
    }
  }

  for (let i = 0; i < PARTICLE_COUNT; i++) particles.push(new Particle());

  const orbs = [
    { ox: 0, oy: 0, lag: 0.06, size: 260, color: '123,94,167', alpha: 0.13 },
    { ox: 0, oy: 0, lag: 0.03, size: 160, color: '180,140,220', alpha: 0.09 },
  ];

  const MAX_LINK_DIST = 110;

  function drawGrid() {
    const mx = mouse.x, my = mouse.y;
    const rippleR = 180;
    ctx.lineWidth = 0.5;
    for (let x = 0; x <= W; x += CELL) {
      for (let y = 0; y <= H; y += CELL) {
        const dx = x - mx, dy = y - my;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const proximity = Math.max(0, 1 - dist / rippleR);
        const alpha = 0.04 + proximity * 0.18;
        ctx.strokeStyle = `rgba(255,255,255,${alpha})`;
        const s = 3 + proximity * 6;
        ctx.beginPath();
        ctx.moveTo(x - s, y); ctx.lineTo(x + s, y);
        ctx.moveTo(x, y - s); ctx.lineTo(x, y + s);
        ctx.stroke();
      }
    }
    for (let x = 0; x <= W; x += CELL) {
      const dx = x - mx;
      const lineAlpha = 0.03 + Math.max(0, 1 - Math.abs(dx) / 300) * 0.05;
      ctx.strokeStyle = `rgba(255,255,255,${lineAlpha})`;
      ctx.lineWidth = 0.4;
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
    }
    for (let y = 0; y <= H; y += CELL) {
      const dy = y - my;
      const lineAlpha = 0.03 + Math.max(0, 1 - Math.abs(dy) / 300) * 0.05;
      ctx.strokeStyle = `rgba(255,255,255,${lineAlpha})`;
      ctx.lineWidth = 0.4;
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
    }
  }

  function tick() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#080c14';
    ctx.fillRect(0, 0, W, H);
    drawGrid();
    orbs.forEach(orb => {
      orb.ox += (mouse.x - orb.ox) * orb.lag;
      orb.oy += (mouse.y - orb.oy) * orb.lag;
      const grad = ctx.createRadialGradient(orb.ox, orb.oy, 0, orb.ox, orb.oy, orb.size);
      grad.addColorStop(0,   `rgba(${orb.color},${orb.alpha})`);
      grad.addColorStop(0.5, `rgba(${orb.color},${orb.alpha * 0.4})`);
      grad.addColorStop(1,   `rgba(${orb.color},0)`);
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(orb.ox, orb.oy, orb.size, 0, Math.PI * 2);
      ctx.fill();
    });
    ctx.lineWidth = 0.5;
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const d = Math.sqrt(dx * dx + dy * dy);
        if (d < MAX_LINK_DIST) {
          const a = (1 - d / MAX_LINK_DIST) * 0.18 * particles[i].life * particles[j].life;
          ctx.strokeStyle = `rgba(180,160,220,${a})`;
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.stroke();
        }
      }
    }
    particles.forEach(p => { p.update(); p.draw(); });
    ctx.beginPath();
    ctx.arc(mouse.x, mouse.y, 3, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(200,180,240,0.7)';
    ctx.fill();
    raf = requestAnimationFrame(tick);
  }

  tick();
})();
</script>